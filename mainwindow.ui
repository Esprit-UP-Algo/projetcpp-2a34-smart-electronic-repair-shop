     <property name="styleSheet">
      <string notr="true">/* Style général de la table */
QTableView {
    background-color: #f0f0f0;  /* couleur de fond */
    gridline-color: #dcdcdc;    /* couleur des lignes */
    font: 12pt &quot;Segoe UI&quot;;      /* police et taille */
    border: 1px solid #ccc;     /* bordure globale */
    selection-background-color: #3399ff;  /* couleur de sélection */
    selection-color: white;     /* couleur du texte sélectionné */
}

/* Style des en-têtes horizontaux */
QHeaderView::section {
    background-color: #4CAF50;  /* couleur de fond */
    color: white;               /* texte blanc */
    padding: 4px;
    border: 1px solid #ddd;     /* bordure des sections */
}

/* Style des en-têtes verticaux */
QHeaderView::section:vertical {
    background-color: #f7f7f7;
    color: black;
    border: 1px solid #ddd;
}

/* Ligne survolée */
QTableView::item:hover {
    background-color: #e0f7fa;
}

/* Ligne sélectionnée */
QTableView::item:selected {
    background-color: #3399ff;
    color: white;
}
</string>
