  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: white;
}

QPushButton {
    background-color: navy;  /* fond bleu marine (#000080) */
    color: white;            /* texte blanc */
    border: 1px solid black; /* bordure noire */
    border-radius: 5px;      /* coins arrondis */
    padding: 5px;            /* espace interne */
}

QPushButton:hover {
    background-color: #000066; /* bleu marine plus foncé au survol */
}
QLabel {
    font-family: &quot;Arial&quot;;   /* police */
    font-size: 16px;        /* taille en pixels */
    font-weight: bold;      /* gras si besoin */
    font-style: italic;     /* italique si besoin */
}





QPushButton:pressed {
    background-color: #000033; /* bleu marine très foncé quand cliqué */
}

QLabel {
    font-family: &quot;Arial&quot;;   /* famille de la police */
    font-size: 16px;        /* taille en pixels */
    font-weight: bold;      /* gras */
    font-style: italic;     /* italique */
}
QLabel {
    font-family: &quot;Arial&quot;;
    font-size: 16px;
    font-weight: bold;
    color: white;           /* texte blanc */
}
QPushButton {
    font-family: &quot;Arial&quot;;   /* police */
    font-size: 14px;        /* taille */
    font-weight: bold;      /* gras */
    font-style: italic;     /* italique */
    color: white;           /* texte blanc */
    background-color: navy; /* fond bleu marine */
}
QTabBar::tab {
    font-family: &quot;Arial&quot;;   /* police */
    font-size: 14px;        /* taille */
    font-weight: bold;      /* gras */
    font-style: italic;     /* italique */
    color: white;           /* texte blanc */
}

QTabBar::tab:selected {
    font-weight: bold;
    color: white;
}
QPushButton {
    background-color: #00008B;  /* bleu foncé */
    color: white;               /* texte blanc */
    border: 1px solid black;    /* bordure noire */
    border-radius: 5px;         /* coins arrondis */
    padding: 5px;               /* espace interne */
}

QPushButton:hover {
    background-color: #000070;  /* bleu plus foncé au survol */
}

QPushButton:pressed {
    background-color: #000050;  /* bleu très foncé quand cliqué */
}
QLabel {
    color: black;         /* texte noir */
    font-family: Arial;   /* police si besoin */
    font-size: 14px;      /* taille si besoin */
    font-weight: normal;  /* gras si besoin */
}
QLabel {
    font-family: &quot;Arial&quot;;   /* famille de police */
    font-size: 16px;        /* taille de police */
    font-weight: bold;      /* gras */
    font-style: italic;     /* italique si besoin */
    color: black;           /* couleur du texte */
}
QHeaderView::section {
    background-color: navy;
    color: white;
    font-weight: bold;
    padding: 4px;
    border: 1px solid #CCCCCC;
}
</string>
